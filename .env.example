# Public base URL of a compatible music API with /search, /fetch, and /lyrics.
# Legacy provider (src/services/musicApi.ts) — currently inactive; the app
# uses src/services/youtubeMusic instead. Kept only as a fallback reference.
# EXPO_PUBLIC variables are bundled into the client; never put secrets here.
EXPO_PUBLIC_MUSIC_API_BASE_URL=https://musicapi.x007.workers.dev

# Base URL of the optional self-hosted stream resolver (see server/README.md)
# — a tiny yt-dlp-backed service you deploy for free (Render/Fly.io/Railway).
# Tried FIRST when YouTube Music's player response has no direct audio URL
# (every adaptiveFormat is signatureCipher-only). Leave unset to skip it.
# EXPO_PUBLIC_STREAM_RESOLVER_URL=https://your-resolver.onrender.com

# Comma-separated base URLs of Piped-API-compatible instances
# (https://docs.piped.video/docs/api-documentation/), tried only if the
# self-hosted resolver above is unset or fails. Public instances rotate and
# are frequently down. Leave unset to use the best-effort default list in
# innertubeConfig.ts.
# EXPO_PUBLIC_PIPED_INSTANCES=https://your-piped-instance.example.com
